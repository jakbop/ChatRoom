    border: none;
    background-color: #ffffff;
    font-size: 24px;
    padding: 14px 20px;
}
QPlainTextEdit#edtMsg {
    border: 2px solid #e0e0e0;
    border-radius: 10px;
    background-color: #ffffff;
    font-size: 24px;
    padding: 10px 14px;
    selection-background-color: #4a90d9;
}
QPlainTextEdit#edtMsg:focus {
    border: 2px solid #4a90d9;
}
QPushButton#btnSend {
    background-color: #4a90d9;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-size: 22px;
    font-weight: bold;
    padding: 10px 24px;
}
QPushButton#btnSend:hover {
    background-color: #3a7bc8;
}
QPushButton#btnSend:pressed {
    background-color: #2e6ab5;
}
QPushButton#btnSendFile {
    background-color: #27ae60;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-size: 18px;
    font-weight: bold;
    padding: 10px 18px;
}
QPushButton#btnSendFile:hover {
    background-color: #219a52;
}
QPushButton#btnSendFile:pressed {
    background-color: #1e8449;
}
QComboBox#cmbMode {
    border: 2px solid #e0e0e0;
    border-radius: 10px;
    background-color: #ffffff;
    font-size: 18px;
    padding: 8px 14px;
    min-width: 140px;
}
QComboBox#cmbMode::drop-down {
    border: none;
    width: 30px;
}
QComboBox#cmbMode QAbstractItemView {
    border: 2px solid #e0e0e0;
    border-radius: 6px;
    background-color: #ffffff;
    font-size: 18px;
    padding: 4px;
    selection-background-color: #4a90d9;
    selection-color: #ffffff;
}
QLabel#lblUsers {
    color: #2c3e50;
    font-size: 18px;
    font-weight: bold;
    padding: 10px 14px;
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
}
QListWidget#lstUsers {
    border: none;
    background-color: #ffffff;
    font-size: 18px;
    padding: 8px;
    outline: none;
}
QListWidget#lstUsers::item {
    padding: 10px 14px;
    border-bottom: 1px solid #f0f0f0;
    border-radius: 6px;
}
QListWidget#lstUsers::item:hover {
    background-color: #eaf4ff;
}
QListWidget#lstUsers::item:selected {
    background-color: #4a90d9;
    color: #ffffff;
}</string>
